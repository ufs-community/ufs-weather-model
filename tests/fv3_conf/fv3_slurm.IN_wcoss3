#!/bin/sh
#SBATCH -e err
#SBATCH -o out
#SBATCH --account=@[ACCNR]
#SBATCH --qos=@[QUEUE]
#SBATCH --partition=@[PARTITION]
#SBATCH --nodes=@[NODES]
#SBATCH --ntasks-per-node=@[TPN]
#SBATCH --cpus-per-task=1
#SBATCH --time=@[WLCLK]
#SBATCH --job-name="@[JBNME]"
@[EXCLUSIVE_NODES_OPT]

set -eux
echo -n " $( date +%s )," > job_timestamp.txt

set +x
MACHINE_ID=wcoss3
source ./module-setup.sh
module use $PWD/modulefiles
module load modules.fv3
module list
set -x

echo "Model started:  " $(date)

ulimit -l unlimited || true
ulimit -n 65535 || true

export OMP_STACKSIZE=2048M
export OMP_NUM_THREADS=@[THRD]

export ESMF_RUNTIME_PROFILE=ON
export ESMF_RUNTIME_PROFILE_OUTPUT="SUMMARY"

export FI_PROVIDER="verbs;ofi_rxm"
export FI_VERBS_INLINE_SIZE=39
export FI_OFI_RXM_BUFFER_SIZE=4096
export FI_UNIVERSE_SIZE=$SLURM_NTASKS
export FI_OFI_RXM_SAR_LIMIT=2147483648

# This "if" block is part of the rt.sh self-tests in error-test.conf.
# It emulates the model failing to run.
if [ "${JOB_SHOULD_FAIL:-NO}" = WHEN_RUNNING ] ; then
    echo "The job should abort now, with exit status 1." 1>&2
    echo "If error checking is working, the metascheduler should mark the job as failed." 1>&2
    false
fi

srun --label --mpi=pmi2 -n @[TASKS] ./fv3.exe

echo "Model ended:    " $(date)
echo -n " $( date +%s )," >> job_timestamp.txt
