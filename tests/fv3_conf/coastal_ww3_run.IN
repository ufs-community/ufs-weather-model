if [ ! -d "INPUT" ]; then
  mkdir INPUT
fi
if [ ! -d "RESTART" ]; then
  mkdir RESTART
fi

for IFILE in @[INPUTDATA_ROOT]/WW3/$HURR/$CPL_CONF/*.nc; do
  if [ -f "$IFILE" ]; then
    cp $IFILE .
  fi
done

for IFILE in @[INPUTDATA_ROOT]/WW3/$HURR/$CPL_CONF/*.msh; do
  if [ -f "$IFILE" ]; then
    cp $IFILE .
  fi
done

for IFILE in @[INPUTDATA_ROOT]/WW3/$HURR/$CPL_CONF/*.list; do
  if [ -f "$IFILE" ]; then
    cp $IFILE .
  fi
done

cp @[INPUTDATA_ROOT]/WW3/$HURR/$CPL_CONF/ww3_* .
cp @[INPUTDATA_ROOT]/WW3/$HURR/$CPL_CONF/mod_def.* .

if [[ $CPL_CONF == 'ww3' ]]; then
  cp @[INPUTDATA_ROOT]/WW3/$HURR/$CPL_CONF/nest.inlet .
  cp @[INPUTDATA_ROOT]/WW3/$HURR/$CPL_CONF/wind.inlet .
  # this is required for standalone ww3 configuration
  ln -sf wind.inlet wind.ww3
fi
