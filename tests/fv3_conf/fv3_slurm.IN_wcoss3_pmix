#!/bin/bash
#SBATCH -e err
#SBATCH -o out
#SBATCH --partition=@[PARTITION]
#SBATCH --nodes=@[NODES]
#SBATCH --ntasks-per-node=@[TPN]
#SBATCH --cpus-per-task=1
#SBATCH --time=@[WLCLK]
#SBATCH --job-name="@[JBNME]"

set -eux
#Hack for NIMBUS EAE until sacct is active
trap 'echo $? > job_exit_status' EXIT
echo -n " $( date +%s )," > job_timestamp.txt

set +x
module use "${PWD}/modulefiles"
module load modules.fv3
module list
module load pmix/5.0.11
set -x

date_start=$(date)
echo "Model started: ${date_start}"

export OMP_STACKSIZE=2048M
export OMP_NUM_THREADS=@[THRD]

export ESMF_RUNTIME_COMPLIANCECHECK=OFF:depth=4
export ESMF_RUNTIME_PROFILE=ON
export ESMF_RUNTIME_PROFILE_OUTPUT="SUMMARY"

export FI_PROVIDER="psm3"

export FI_VERBS_INLINE_SIZE=39
export FI_OFI_RXM_BUFFER_SIZE=4096
export FI_UNIVERSE_SIZE=$SLURM_NTASKS
export FI_OFI_RXM_SAR_LIMIT=2147483648

#export I_MPI_PIN_DOMAIN=numa

export I_MPI_DEBUG=5
ulimit -l unlimited || true
ulimit -n 65535 || true

srun --label --mpi=pmix ./fv3.exe

date_end=$(date)
echo "Model ended: ${date_end}"
date_s_end=$(date +%s)
echo -n "${date_s_end}," >> job_timestamp.txt

