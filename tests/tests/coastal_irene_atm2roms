###############################################################################
#
# ROMS coupled coastal_irene_atm2roms configuration
#
###############################################################################

TEST_DESCR="Compare coastal_irene_atm2roms results with previous trunk version"

CNTL_DIR=coastal_irene_atm2roms

LIST_FILES="irene_avg.nc \
            irene_his.nc \
            irene_rst.nc"

# deafult options
export_coastal

# model_configure
SYEAR=2011
SMONTH=08
SDAY=27
SHOUR=06
FHMAX=42
FHROT=0
# not used
DT_ATMOS=720
RESTART_INTERVAL=0
QUILTING=.true.
QUILTING_RESTART=.false.
WRITE_GROUP=1
WRTTASK_PER_GROUP=6
ITASKS=1
OUTPUT_HISTORY=.true.
WRITE_DOPOST=.false.
NUM_FILES=2
FILENAME_BASE="'atm' 'sfc'"
OUTPUT_GRID="'cubed_sphere_grid'"
OUTPUT_FILE="'netcdf'"
IDEFLATE=0
NBITS=0
ICHUNK2D=0
JCHUNK2D=0
ICHUNK3D=0
JCHUNK3D=0
KCHUNK3D=0
IMO=384
JMO=190
WRITE_NSFLIP=.false.
OUTPUT_FH="12 -1"
IAU_OFFSET=0
if [[ " hera orion hercules gaea jet frontera " =~ " ${MACHINE_ID} " ]] ; then
  ZSTANDARD_LEVEL=5
fi

# datm, namelist files are provided by ROMS testing repository
DATM_CDEPS=true
DATM_IN_CONFIGURE=datm_in.coastal.IN
DATM_STREAM_CONFIGURE=datm.streams.multi.coastal.IN
atm_datamode="ATMMESH"
MESH_ATM="\"INPUT/irene_roms_grid_rho_ESMFmesh.nc\""
MESH_STREAM="INPUT/era5_IRENE_ESMFmesh.nc"
ATM_NX_GLB=242
ATM_NY_GLB=106
EXPORT_ALL=.true.
FILENAME_BASE='atmmesh.'
STREAM_VECTORS="null"
stream_files="INPUT/era5_IRENE.nc"
mapalgo=redist
dtlimit=1.5
STREAM_OFFSET=-3600

# datm/ocean
HURR="IRENE"
CPL_CONF="roms_data_cmeps"

# pes
ATM_compute_tasks=12
OCN_tasks=12

# configuration
MODEL_CONFIGURE=model_configure.IN
UFS_CONFIGURE=ufs.configure.coastal_datm_ocn.IN
med_model=cmeps
med_petlist_bounds="0 23"
med_omp_num_threads=1
atm_model=datm
atm_petlist_bounds="0 11"
atm_omp_num_threads=1
ocn_model=roms
ocn_petlist_bounds="12 23"
ocn_omp_num_threads=1
coupling_interval_slow_sec=60
RESTART_N=12
RUNTYPE=startup
CPLMODE=coastal
coupling_config=roms_cmeps_era5.yaml
# input files
FV3_RUN="coastal_roms_run.IN"
CMP_DATAONLY=true
