CNTL_DIR=coastal_sandy_duck_atm2sch

lst=""
for n in `seq -f "%06g" 0 159`
do
  if [ "$n" == "000000" ]; then
    lst="outputs/schout_${n}_1.nc outputs/schout_${n}_2.nc"
  else
    lst="$lst outputs/schout_${n}_1.nc outputs/schout_${n}_2.nc"
  fi
done

LIST_FILES="${lst} ufs.cpld.cpl.hi.2012-10-27-21600.nc"

# default options
export_coastal

# model_configure
SYEAR=2012
SMONTH=10
SDAY=27
