# This configuration is supposed to match the rrfs_dev1 parallel, so
# do not change the namelist without checking the current parallel.

TEST_DESCR="HRRR physics on 13km domain, two threads"

CNTL_DIR=conus13km_control

LIST_FILES="sfcf000.nc \
            sfcf001.nc \
            atmf000.nc \
            atmf001.nc"

export_hrrr_conus13km
RESTART_INTERVAL=1
FHMAX=1
atm_omp_num_threads=2
QUILTING_RESTART=.false.
USE_MERRA2=.true.

ESMF_THREADING=false
THRD=$atm_omp_num_threads
ZSTANDARD_LEVEL=5

if [[ ${MACHINE_ID} = ursa ]]; then
  EXCLUSIVE_NODES=.true.
fi
