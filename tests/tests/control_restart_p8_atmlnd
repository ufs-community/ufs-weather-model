###############################################################################
#
#  Global control test GFSv16 atmosphere-land only at C96L127, P8 configuration
#
###############################################################################

source tests/control_restart_p8

TEST_DESCR="Compare global control results with previous trunk version"

CNTL_DIR=control_p8_atmlnd

LIST_FILES="sfcf024.tile1.nc \
            sfcf024.tile2.nc \
            sfcf024.tile3.nc \
            sfcf024.tile4.nc \
            sfcf024.tile5.nc \
            sfcf024.tile6.nc \
            atmf024.tile1.nc \
            atmf024.tile2.nc \
            atmf024.tile3.nc \
            atmf024.tile4.nc \
            atmf024.tile5.nc \
            atmf024.tile6.nc \
            ufs.cpld.lnd.out.2021-03-23-21600.tile1.nc \
            ufs.cpld.lnd.out.2021-03-23-21600.tile2.nc \
            ufs.cpld.lnd.out.2021-03-23-21600.tile3.nc \
            ufs.cpld.lnd.out.2021-03-23-21600.tile4.nc \
            ufs.cpld.lnd.out.2021-03-23-21600.tile5.nc \
            ufs.cpld.lnd.out.2021-03-23-21600.tile6.nc"
RESTART_FILE_PREFIX=$(set_restart_file_prefix)
RESTART_FILE_SUFFIX_SECS=$(set_restart_file_suffix_secs)
FV3_RUN="noahmp_run.IN"

CPLLND=.true.
CPLLND2ATM=.true.

UFS_CONFIGURE=ufs.configure.atm_lnd.IN
med_model=cmeps
atm_model=fv3
lnd_model=noahmp
CMEPS_PIO_FORMAT='pnetcdf'
CMEPS_PIO_STRIDE=4
CMEPS_PIO_IOTASKS=-99
CMEPS_PIO_REARR='box'
CMEPS_PIO_ROOT=-99
samegrid_atmlnd=.true.
CPLMODE=ufs.frac
RUNTYPE=continue
READRESTART=.true.
CMEPS_RESTART_DIR=./RESTART/
cap_dbug_flag=0
ATM_tasks=144
LND_tasks=144
lnd_ic_type=sfc
CALC_SNET=.false.
layout_x=3
layout_y=8
OCNRES=100
LNDRES=C96
coupling_interval_sec=720
snow_albedo_option=1
precip_partition_option=4
initial_albedo=0.2
WRITE_DOPOST=.false.
OUTPUT_GRID=cubed_sphere_grid
OUTPUT_FH="1 -1"
if [[ "$ATMRES" = "$LNDRES" ]]; then
  lnd_input_dir="INPUT/"
  mosaic_file="INPUT/${LNDRES}_mosaic.nc"
  lnd_fixed_dir="./"
else
  lnd_input_dir="INPUT/${LNDRES}/"
  mosaic_file="INPUT/${LNDRES}/${LNDRES}_mosaic.nc"
  lnd_fixed_dir="INPUT/${LNDRES}/"
fi
ZSTANDARD_LEVEL=0
