IDEFLATE=0
NBITS=0
ICHUNK2D=0
JCHUNK2D=0
ICHUNK3D=0
JCHUNK3D=0
KCHUNK3D=0
IMO=384
JMO=190
WRITE_NSFLIP=.false.
OUTPUT_FH="12 -1"
IAU_OFFSET=0
if [[ " hera orion hercules gaea jet frontera " =~ " ${MACHINE_ID} " ]] ; then
  ZSTANDARD_LEVEL=5
fi

# datm
DATM_CDEPS=true
DATM_IN_CONFIGURE=datm_in.coastal.IN
DATM_STREAM_CONFIGURE=datm.streams.coastal.IN
atm_datamode="ERA5"
