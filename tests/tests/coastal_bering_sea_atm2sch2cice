TEST_DESCR="Compare coastal_bering_sea_atm2sch2cice results with previous trunk version"

CNTL_DIR=coastal_bering_sea_atm2sch2cice

lst=""
for n in `seq -f "%06g" 0 479`
do
  if [ "$n" == "000000" ]; then
    lst="outputs/schout_${n}_1.nc"
  else
    lst="$lst outputs/schout_${n}_1.nc"
  fi
done

LIST_FILES="${lst} history/iceh_01h.2020-05-01-54000.nc ufs.cpld.cpl.hi.2020-05-01-54000.nc"

# default options
export_coastal

# model_configure
SYEAR=2020
SMONTH=05
SDAY=01
SHOUR=12
FHMAX=3
FHROT=0
# not used
DT_ATMOS=720
RESTART_INTERVAL=0
QUILTING=.true.
QUILTING_RESTART=.false.
WRITE_GROUP=1
WRTTASK_PER_GROUP=6
ITASKS=1
OUTPUT_HISTORY=.true.
WRITE_DOPOST=.false.
NUM_FILES=2
FILENAME_BASE="'atm' 'sfc'"
OUTPUT_GRID="'cubed_sphere_grid'"
