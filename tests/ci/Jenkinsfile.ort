ciRunningNode = []
matchedNode = []
generateBaselineNode = []
for (label in pullRequest.labels) {
    listOfLabelNodeNames = jenkins.model.Jenkins.instance.nodes.collect {
        node -> node.getLabelString().contains(label) ? node.name : null
    
        if (label.startsWith(node.getLabelString() + "-") && label.contains("CI_RUNNING")) {
           ciRunningNode += node.getLabelString()
        }

        if ((label.matches(node.getLabelString()+"(.*)-ORT"))) {
           matchedNode += node.getLabelString()
        }         

    }
}

matchedNode = matchedNode.unique()
ciRunningNode = ciRunningNode.unique()
matchedNode = matchedNode - ciRunningNode

modifiedLabels = matchedNode.collect{"'" + it + "'"} 
baselineLabels = generateBaselineNode.collect{"'" + it + "'"} 

if (modifiedLabels.isEmpty()) {
   echo "No new labels. Skipping build."
   currentBuild.result = 'NOT_BUILT'
   return // Exits the stage/script early
}

def generateStage(nodeLabel) {
    return {
        stage("Run regional_control on ${nodeLabel.replaceAll("'","")}") {
            node(nodeLabel) {
                cleanWs()
                checkout scm
		script {
                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') { 
                 sh '''
                  export machine=${NODE_NAME,,}
                  git submodule update --init --recursive
                  cd tests/fv3_conf
                  sed 's/#SBATCH --time=.*/#SBATCH --time=02:00:00/g' -i fv3_slurm.IN_${machine}
                  cd ..
                  export PATH=$PATH:~/bin
                  export SSH_ORIGIN=$(curl --silent https://api.github.com/repos/ufs-community/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.repo.ssh_url')
                  export FORK_BRANCH=$(curl --silent https://api.github.com/repos/ufs-community/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.ref')
                  export ACCNR=epic
                  export GIT_OWNER=$(echo $GIT_URL | cut -d '/' -f4)
                  export GIT_REPO_NAME=$(echo $GIT_URL | cut -d '/' -f5 | cut -d '.' -f1)
                  echo "GIT_OWNER ${GIT_OWNER}"
                  echo "GIT_REPO_NAME ${GIT_REPO_NAME}"

                   echo "https://api.github.com/repos/${GIT_OWNER}/${GIT_REPO_NAME}/issues/${CHANGE_ID}/labels/${machine}-CI_RUNNING"
                   curl --silent -X POST -H "Accept: application/vnd.github.v3+json" -H "Authorization: Bearer ${GITHUB_TOKEN}"  https://api.github.com/repos/"${GIT_OWNER}"/"${GIT_REPO_NAME}"/issues/"${CHANGE_ID}"/labels -d '{"labels":["'"$machine"'-CI_RUNNING"]}'

                  pwd
                  ./opnReqTest -n regional_control -a ${ACCNR} -c bit,dcp,thr
                  cd logs/
                  # change "cp" to "mv" to be tighter on logfiles existence (prevents using logfiles from a previous run)
                  mv OpnReqTests_regional_control_${machine}.log $WORKSPACE/..
                  cd ..
                  pwd
                '''
                } 
                 echo "Ran regional_control on ${NODE_NAME}"
                }
            }
        }
        stage("Run control_p8 on ${nodeLabel.replaceAll("'","")}") {
            node(nodeLabel) {
		script {
                   cleanWs()
                   checkout scm
                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') { 
                sh '''
                  export machine=${NODE_NAME,,}
                  git submodule update --init --recursive
                  cd tests/fv3_conf
                  sed 's/#SBATCH --time=.*/#SBATCH --time=02:00:00/g' -i fv3_slurm.IN_${machine}
                  cd ..
                  export PATH=$PATH:~/bin
                  export SSH_ORIGIN=$(curl --silent https://api.github.com/repos/ufs-community/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.repo.ssh_url')
                  export FORK_BRANCH=$(curl --silent https://api.github.com/repos/ufs-community/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.ref')
                  export ACCNR=epic
                  export GIT_OWNER=$(echo $GIT_URL | cut -d '/' -f4)
                  export GIT_REPO_NAME=$(echo $GIT_URL | cut -d '/' -f5 | cut -d '.' -f1)
                  echo "GIT_OWNER ${GIT_OWNER}"
                  echo "GIT_REPO_NAME ${GIT_REPO_NAME}"

                  pwd
                  ./opnReqTest -n control_p8 -a ${ACCNR} -c std,dbg,bit,mpi,rst,thr,dcp
                  cd logs/
                  # change "cp" to "mv" to be tighter on logfiles existence (prevents using logfiles from a previous run)
                  mv OpnReqTests_control_p8_${machine}.log $WORKSPACE/..
                  cd ..
                  pwd
                '''
                  }
			echo "Ran control_p8 on NODE_NAME=${NODE_NAME}" 
                }
            }
        }
        stage("Finalize on ${nodeLabel.replaceAll("'","")}") {
            node(nodeLabel) {
		script {
                  env.BUILD_STATUS = currentBuild.currentResult
                  sh '''
                    export machine=${NODE_NAME,,}
                    export PATH=$PATH:~/bin
                    export SSH_ORIGIN=$(curl --silent https://api.github.com/repos/ufs-community/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.repo.ssh_url')
                    export FORK_BRANCH=$(curl --silent https://api.github.com/repos/ufs-community/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.ref')
                    export ACCNR=epic
                    export GIT_OWNER=$(echo $GIT_URL | cut -d '/' -f4)
                    export GIT_REPO_NAME=$(echo $GIT_URL | cut -d '/' -f5 | cut -d '.' -f1)
                    echo "GIT_OWNER ${GIT_OWNER}"
                    echo "GIT_REPO_NAME ${GIT_REPO_NAME}"

                    echo 'cd tests'
                    pwd
                    git remote -v
                    git fetch --no-recurse-submodules origin
                    git reset FETCH_HEAD --hard
                    cd $WORKSPACE/..
                    echo '3 cds'
                    pwd
                    ls -l

                    # change "cp" to "mv" to be tighter on logfiles existence (prevents using logfiles from a previous run)
                    mv OpnReqTests_control_p8_${machine}.log $WORKSPACE/tests/logs/
                    mv OpnReqTests_regional_control_${machine}.log $WORKSPACE/tests/logs/
                    cd $WORKSPACE/tests/
                    git config user.email "ecc.platform@noaa.gov"
                    git config user.name "epic-cicd-jenkins"
                    export machine_name_logs=$(echo $machine | awk '{ print tolower($1) }')
                    git remote -v | grep -w sshorigin > /dev/null 2>&1 && git remote remove sshorigin > /dev/null 2>&1
                    git remote add sshorigin $SSH_ORIGIN > /dev/null 2>&1
                    git add logs/OpnReqTests_control_p8_${machine}.log logs/OpnReqTests_regional_control_${machine}.log

                    if [[ $BUILD_STATUS == "SUCCESS" ]]; then 
                       echo $BUILD_STATUS
                       git commit -m "${NODE_NAME} ORT Completed. on-behalf-of @ufs-community <ecc.platform@noaa.gov>"
                    else
                       echo "It failed!"
                       git commit -m "${NODE_NAME} ORT Failed! on-behalf-of @ufs-community <ecc.platform@noaa.gov>"
                       
                    fi

                    git pull sshorigin $FORK_BRANCH
                    git push sshorigin HEAD:$FORK_BRANCH

                    echo "Testing concluded for ${GIT_URL}"
                    GIT_OWNER=$(echo $GIT_URL | cut -d '/' -f4)
                    GIT_REPO_NAME=$(echo $GIT_URL | cut -d '/' -f5 | cut -d '.' -f1)
                    echo "Removing labels from $GIT_URL"
                    echo "https://api.github.com/repos/${GIT_OWNER}/${GIT_REPO_NAME}/issues/${CHANGE_ID}/labels/$machine-ORT"
                    curl --silent -X DELETE -H "Accept:   application/vnd.github.v3+json" -H "Authorization:   Bearer ${GITHUB_TOKEN}"  https://api.github.com/repos/${GIT_OWNER}/${GIT_REPO_NAME}/issues/${CHANGE_ID}/labels/$machine-ORT
                    curl --silent -X DELETE -H "Accept: application/vnd.github.v3+json" -H "Authorization: Bearer ${GITHUB_TOKEN}"  https://api.github.com/repos/${GIT_OWNER}/${GIT_REPO_NAME}/issues/${CHANGE_ID}/labels/{$machine}-CI_RUNNING
                  '''
                }
            }
        }
   }
}

def parallelStagesMap = modifiedLabels.collectEntries {
    ["${it}" : generateStage(it)]
}

pipeline {
    agent none
     environment {
            ACCNR = 'epic'
            BUILD_STATUS = "${currentBuild.currentResult}"
            GITHUB_TOKEN = credentials('GithubJenkinsNew')
            GIT_URL = 'https://github.com/ufs-community/ufs-weather-model.git'
          }  
    stages {
        stage('Run Operational Requirements Tests in Parallel') {
            steps {
                script {
                    parallel parallelStagesMap
                }
            }
        }
    }
    post {
      success {
        slackSend (
          channel:   '#jenkins-notifications',
          color:   'good',
          message:   "*SUCCESS:   Build ${env.JOB_NAME} #${env.BUILD_NUMBER}* <${env.BUILD_URL}|Open Build>"
        )
      } // End of success

       aborted {
        slackSend (
          channel:   '#jenkins-notifications',
          color:   'warning',
          message:   "*TIMEOUT:   Build ${env.JOB_NAME} #${env.BUILD_NUMBER}* <${env.BUILD_URL}|Open Build>"
        )
      } // End of aborted
       
      failure {
        slackSend (
          channel:   '#jenkins-notifications',
          color:   'danger',
          message:   "*FAILURE:   Build ${env.JOB_NAME} #${env.BUILD_NUMBER}* <${env.BUILD_URL}|Open Build>"
        ) // End of slacksend
      } // End of failure
    } //End of post
}
