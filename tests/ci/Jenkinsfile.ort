pipeline {
  agent none
  options{
    disableConcurrentBuilds()
  }
   environment {
      ursa_status = 'SUCCESS'
      hercules_status = 'SUCCESS'
      orion_status = 'SUCCESS'
     }
  stages {

    stage('Run ORTs') {
      agent { label 'built-in' }
          environment {
            ACCNR = 'epic'
            NODE_PATH = '/scratch3/NAGAPE/epic/role-epic/'
            GITHUB_TOKEN = credentials('GithubJenkinsNew')
          }
          when{ 
            beforeAgent true
              expression { pullRequest.labels }
          }
      steps {
        script {
          env.CHOICE_NODE = ''
          
          for (label in pullRequest.labels) {
            if (label.contains("orion")) {
              env.CHOICE_NODE+='orion'
            }  
            else if (label.contains("hera")) { 
              env.CHOICE_NODE+='hera'
            }  
            else if (label.contains("hercules")) { 
              env.CHOICE_NODE+='hercules'
            }  
            else if (label.contains("gaeac6")) {
              env.CHOICE_NODE+='gaeac6'
            } 
            else if (label.contains("ursa")) {
              env.CHOICE_NODE+='ursa'
            }
          } // End of for loop

          echo "${env.CHOICE_NODE}"

        } // End of script block
      } // End of steps
    } // End of stage Run ORTS

    stage('Run ORT on All Hosts Parallel'){

      parallel{
        stage('Ursa'){
          agent{ label 'Ursa' }
          options{
            timeout(time:   6,   unit:   'HOURS')
          }
          environment {
            ACCNR = 'epic'
            NODE_PATH = '/scratch3/NAGAPE/epic/role-epic/'
            GITHUB_TOKEN = credentials('GithubJenkinsNew')
            region_result='SUCCESS'
            control_result='SUCCESS'
          }
          when{ 
            beforeAgent true
              expression { env.CHOICE_NODE.contains("ursa") }
          }
          stages{
            stage("regional_control"){
              steps{
                cleanWs()
                checkout scm
                script{
                def exitCode = sh(
                script: '''
                  set +e

                    log_error() {
                        echo "ERROR in $1 on line $2" > $WORKSPACE/tests/error.log
                    }

                  git submodule update --init --recursive
                  cd tests/fv3_conf
                  sed 's/#SBATCH --time=.*/#SBATCH --time=02:00:00/g' -i fv3_slurm.IN_ursa
                  cd ..
                  export ACCNR=epic
                  pwd
                  ./opnReqTest -n regional_control -a ${ACCNR} -c bit,dcp,thr  || log_error OpenReqTest $LINENO
                  cd $WORKSPACE/tests/logs/
                  # change "cp" to "mv" to be tighter on logfiles existence (prevents using logfiles from a previous run)
                  mv OpnReqTests_regional_control_ursa.log $WORKSPACE/..
                  cd ..
                  pwd
                  [ -s $WORKSPACE/tests/error.log ] && rm $WORKSPACE/tests/error.log && exit 1 - z|| exit 0 
                  ''',
                  returnStatus: true
                ) // exitCode
                echo "Ursa regional_control exit code: ${exitCode}"
                if (exitCode == 0) {
                  echo "Pipeline continuing normally."
                  region_result = 'SUCCESS'
                } else {
                // Suppress build failure: Mark STAGE as failed, but keep BUILD as success
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    error "Handling Ursa regional_control failure in groovy, changing stage color to unstable"
                }
                  region_result = 'FAILURE'
                }
                echo "region_result = ${region_result}"
                } //script

              } // End of steps
            } // End of stage regional control
            
            stage("control_p8"){
              steps{
                cleanWs()
                checkout scm
                script{
                def exitCode = sh(
                script: '''
                  set +e

                    log_error() {
                        echo "ERROR in $1 on line $2" > $WORKSPACE/tests/error.log
                    }

                  git submodule update --init --recursive
                  cd tests/fv3_conf
                  sed 's/#SBATCH --time=.*/#SBATCH --time=02:00:00/g' -i fv3_slurm.IN_ursa
                  cd ..
                  export ACCNR=epic
                  export GIT_OWNER=$(echo $GIT_URL | cut -d '/' -f4)
                  export GIT_REPO_NAME=$(echo $GIT_URL | cut -d '/' -f5 | cut -d '.' -f1)
                  echo "GIT_OWNER ${GIT_OWNER}"
                  echo "GIT_REPO_NAME ${GIT_REPO_NAME}"
                  pwd
                  ./opnReqTest -n control_p8 -a ${ACCNR} -c std,dbg,bit,mpi,rst,thr,dcp  || log_error OpenReqTest $LINENO
                  cd logs/
                  # change "cp" to "mv" to be tighter on logfiles existence (prevents using logfiles from a previous run)
                  mv OpnReqTests_control_p8_ursa.log $WORKSPACE/..
                  cd ..
                  pwd
                  [ -s $WORKSPACE/tests/error.log ] && rm $WORKSPACE/tests/error.log && exit 1 || exit 0    
                  ''',
                  returnStatus: true
                ) // exitCode
                echo "Ursa control_p8 exit code: ${exitCode}"
                if (exitCode == 0) {
                  echo "Pipeline continuing normally."
                  control_result = 'SUCCESS'
                } else {
                // Suppress build failure: Mark STAGE as failed, but keep BUILD as success
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    error "Handling Ursa failure in groovy, changing stage color to unstable"
                }
                  control_result = 'FAILURE'
                }
                echo "control_result = ${control_result}"
                } //script
              } // End of steps
            } // End of control_p8 stage
            
            stage("Finalize Ursa"){ 
              steps{
                script{
                echo "test for fail"
                echo "region_result = ${region_result}"
                echo "control_result = ${control_result}"
                if ( region_result == 'FAILURE' || control_result == 'FAILURE') {
                   echo "Ursa ORT Failed (Unstable)"
                   currentBuild.result = "UNSTABLE"
                   stageResult = "UNSTABLE"
                   ursa_status = 'UNSTABLE'
                } else {
                   echo "Ursa ORT Success"
                   currentBuild.result = "SUCCESS"
                   stageResult = "SUCCESS"
                } 
                } // script
                sh '''
                  set +e
                  export machine=${NODE_NAME}
                  export PATH=$PATH:~/bin
                  export SSH_ORIGIN=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.repo.ssh_url')
                  export FORK_BRANCH=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.ref')
                  export ACCNR=epic
                  export GIT_OWNER=$(echo $GIT_URL | cut -d '/' -f4)
                  export GIT_REPO_NAME=$(echo $GIT_URL | cut -d '/' -f5 | cut -d '.' -f1)
                  echo "GIT_OWNER ${GIT_OWNER}"
                  echo "GIT_REPO_NAME ${GIT_REPO_NAME}"

                  echo 'cd tests'
                  pwd 
                  git remote -v
                  git fetch --no-recurse-submodules origin
                  git reset FETCH_HEAD --hard
                  cd $WORKSPACE/..
                  echo '3 cds'
                  pwd
                  ls -l

                  # change "cp" to "mv" to be tighter on logfiles existence (prevents using logfiles from a previous run)
                  mv OpnReqTests_control_p8_ursa.log $WORKSPACE/tests/logs/
                  mv OpnReqTests_regional_control_ursa.log $WORKSPACE/tests/logs/
                  '''
              } // End of steps 

              post{
                always{
                  echo "currentBuild.result $currentBuild.result"
                  sh '''
                  set +e
                  export machine=${NODE_NAME}
                  export PATH=$PATH:~/bin
                  export SSH_ORIGIN=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.repo.ssh_url')
                  export FORK_BRANCH=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.ref')
                  export ACCNR=epic
                  export GIT_OWNER=$(echo $GIT_URL | cut -d '/' -f4)
                  export GIT_REPO_NAME=$(echo $GIT_URL | cut -d '/' -f5 | cut -d '.' -f1)
                  git config user.email "ecc.platform@noaa.gov"
                  git config user.name "epic-cicd-jenkins"
                  export machine_name_logs=$(echo $machine | awk '{ print tolower($1) }')
                  git remote -v | grep -w sshorigin > /dev/null 2>&1 && git remote remove sshorigin > /dev/null 2>&1
                  git remote add sshorigin $SSH_ORIGIN > /dev/null 2>&1
                  echo "Finalizing Ursa"
                  '''
                 } // always

              unstable{
                  echo "currentBuild.result $currentBuild.result"
                    sh '''
                  set +e
                  export machine=${NODE_NAME}
                  export PATH=$PATH:~/bin
                  export SSH_ORIGIN=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.repo.ssh_url')
                  export FORK_BRANCH=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.ref')
                  export ACCNR=epic
                  export GIT_OWNER=$(echo $GIT_URL | cut -d '/' -f4)
                  export GIT_REPO_NAME=$(echo $GIT_URL | cut -d '/' -f5 | cut -d '.' -f1)
                  
                  cd $WORKSPACE/tests/
                  export regional_dir=$(egrep opnReqTest_[1-9]* -m 1 logs/OpnReqTests_regional_control_ursa.log | cut -c 1-101 )
                  export control_dir=$(egrep opnReqTest_[1-9]* -m 1 logs/OpnReqTests_control_p8_ursa.log | cut -c 1-101 )

                    git add logs/OpnReqTests_control_p8_ursa.log logs/OpnReqTests_regional_control_ursa.log
                    git status
                    git commit -m "Ursa ORT FAILED.\nregional_dir=${regional_dir}\ncontrol_dir=${control_dir}\n on-behalf-of @ufs-community <ecc.platform@noaa.gov>"
                    git config pull.rebase false
                    git pull sshorigin $FORK_BRANCH
                    git push sshorigin HEAD:$FORK_BRANCH
                  echo "Ursa Failed"
                    '''
                  }

              success{
                  echo "currentBuild.result $currentBuild.result"
                    sh '''
                  set +e
                  export machine=${NODE_NAME}
                  export PATH=$PATH:~/bin
                  export SSH_ORIGIN=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.repo.ssh_url')
                  export FORK_BRANCH=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.ref')
                  export ACCNR=epic
                  export GIT_OWNER=$(echo $GIT_URL | cut -d '/' -f4)
                  export GIT_REPO_NAME=$(echo $GIT_URL | cut -d '/' -f5 | cut -d '.' -f1)
                  cd $WORKSPACE/tests/
                  export regional_dir=$(egrep opnReqTest_[1-9]* -m 1 logs/OpnReqTests_regional_control_ursa.log | cut -c 1-101 )
                  export control_dir=$(egrep opnReqTest_[1-9]* -m 1 logs/OpnReqTests_control_p8_ursa.log | cut -c 1-101 )
                    git add logs/OpnReqTests_control_p8_ursa.log logs/OpnReqTests_regional_control_ursa.log
                    git status
                    git commit -m "Ursa ORT Successful.\nregional_dir=${regional_dir}\ncontrol_dir=${control_dir}\n on-behalf-of @ufs-community <ecc.platform@noaa.gov>"
                    git config pull.rebase false
                    git pull sshorigin $FORK_BRANCH
                    git push sshorigin HEAD:$FORK_BRANCH
                  echo "Ursa success"
                    '''
                   }

                } // end of post

            } // End of stage finalize ursa
          } // End of stages
        } // End of Ursa stage
 
        stage('Hercules'){
          agent{ label 'hercules' }
          options{
            timeout(time:   6,   unit:   'HOURS')
          }
          environment {
            ACCNR = 'epic'
            NODE_PATH = '/work2/noaa/epic/role-epic/'
            GITHUB_TOKEN = credentials('GithubJenkinsNew')
          }
          when{ 
            beforeAgent true
              expression { env.CHOICE_NODE.contains("hercules") }
          }
          stages{
            stage("regional_control"){
              steps{
                cleanWs()
                checkout scm
                script{
                def exitCode = sh(
                script: '''
                  set +e

                    log_error() {
                        echo "ERROR in $1 on line $2" > $WORKSPACE/tests/error.log
                    }

                  git submodule update --init --recursive
                  cd tests/fv3_conf
                  sed 's/#SBATCH --time=.*/#SBATCH --time=02:00:00/g' -i fv3_slurm.IN_ursa
                  cd ..
                  export ACCNR=epic
                  pwd
                  ./opnReqTest -n regional_control -a ${ACCNR} -c bit,dcp,thr  || log_error OpenReqTest $LINENO
                  cd $WORKSPACE/tests/logs/
                  # change "cp" to "mv" to be tighter on logfiles existence (prevents using logfiles from a previous run)
                  mv OpnReqTests_regional_control_hercules.log $WORKSPACE/..
                  cd ..
                  pwd
                  [ -s $WORKSPACE/tests/error.log ] && rm $WORKSPACE/tests/error.log && exit 1 - z|| exit 0 
                  ''',
                  returnStatus: true
                ) // exitCode
                echo "Ursa regional_control exit code: ${exitCode}"
                if (exitCode == 0) {
                  echo "Pipeline continuing normally."
                  region_result = 'SUCCESS'
                } else {
                // Suppress build failure: Mark STAGE as failed, but keep BUILD as success
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    error "Handling Hercules regional_control failure in groovy, changing stage color to unstable"
                }
                  region_result = 'FAILURE'
                }
                echo "region_result = ${region_result}"
                } //script

              } // End of steps
            } // End of stage regional_control
            
            stage("control_p8"){
              steps{
                cleanWs()
                checkout scm
                script{
                def exitCode = sh(
                script: '''
                  set +e

                    log_error() {
                        echo "ERROR in $1 on line $2" > $WORKSPACE/tests/error.log
                    }

                  git submodule update --init --recursive
                  cd tests/fv3_conf
                  sed 's/#SBATCH --time=.*/#SBATCH --time=02:00:00/g' -i fv3_slurm.IN_ursa
                  cd ..
                  export ACCNR=epic
                  export GIT_OWNER=$(echo $GIT_URL | cut -d '/' -f4)
                  export GIT_REPO_NAME=$(echo $GIT_URL | cut -d '/' -f5 | cut -d '.' -f1)
                  echo "GIT_OWNER ${GIT_OWNER}"
                  echo "GIT_REPO_NAME ${GIT_REPO_NAME}"
                  pwd
                  ./opnReqTest -n control_p8 -a ${ACCNR} -c std,dbg,bit,mpi,rst,thr,dcp  || log_error OpenReqTest $LINENO
                  cd logs/
                  # change "cp" to "mv" to be tighter on logfiles existence (prevents using logfiles from a previous run)
                  mv OpnReqTests_control_p8_hercules.log $WORKSPACE/..
                  cd ..
                  pwd
                  [ -s $WORKSPACE/tests/error.log ] && rm $WORKSPACE/tests/error.log && exit 1 || exit 0    
                  ''',
                  returnStatus: true
                ) // exitCode
                echo "Hercules control_p8 exit code: ${exitCode}"
                if (exitCode == 0) {
                  echo "Pipeline continuing normally."
                  control_result = 'SUCCESS'
                } else {
                // Suppress build failure: Mark STAGE as failed, but keep BUILD as success
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    error "Handling Hercules control_p8 failure in groovy, changing stage color to unstable"
                }
                  control_result = 'FAILURE'
                }
                echo "control_result = ${control_result}"
                } //script
              } // End of steps
            } // End of stage control_p8
            
            // Stage to finalize Hercules operations
            stage("Finalize Hercules"){ 
              steps{
                script{
                echo "test for fail"
                echo "region_result = ${region_result}"
                echo "control_result = ${control_result}"
                buildResult='SUCCESS'
                if ( region_result == 'FAILURE' || control_result == 'FAILURE') {
                   echo "Hercules ORT Failed (Unstable)"
                   currentBuild.result='UNSTABLE'
                   stageResult="UNSTABLE"
                   hercules_status='UNSTABLE'
                } else {
                   echo "Hercules ORT Success"
                   currentBuild.result='SUCCESS'
                   stageResult = 'SUCCESS'
                } 
                } // script
                sh '''
                  set +e
                  export machine=${NODE_NAME}
                  export PATH=$PATH:~/bin
                  export SSH_ORIGIN=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.repo.ssh_url')
                  export FORK_BRANCH=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.ref')
                  export ACCNR=epic
                  export GIT_OWNER=$(echo $GIT_URL | cut -d '/' -f4)
                  export GIT_REPO_NAME=$(echo $GIT_URL | cut -d '/' -f5 | cut -d '.' -f1)
                  echo "GIT_OWNER ${GIT_OWNER}"
                  echo "GIT_REPO_NAME ${GIT_REPO_NAME}"

                  pwd 
                  git remote -v
                  git fetch --no-recurse-submodules origin
                  git reset FETCH_HEAD --hard
                  cd $WORKSPACE/..

                  echo '3 cds'
                  pwd
                  ls -l

                  # change "cp" to "mv" to be tighter on logfiles existence (prevents using logfiles from a previous run)
                  mv OpnReqTests_control_p8_hercules.log $WORKSPACE/tests/logs/
                  mv OpnReqTests_regional_control_hercules.log $WORKSPACE/tests/logs/
                  '''
           } // End of steps 

              post{
                always{
                  echo "currentBuild.result $currentBuild.result"
                  sh '''
                  set +e
                  export machine=${NODE_NAME}
                  export PATH=$PATH:~/bin
                  export SSH_ORIGIN=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.repo.ssh_url')
                  export FORK_BRANCH=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.ref')
                  export ACCNR=epic
                  export GIT_OWNER=$(echo $GIT_URL | cut -d '/' -f4)
                  export GIT_REPO_NAME=$(echo $GIT_URL | cut -d '/' -f5 | cut -d '.' -f1)
                  git config user.email "ecc.platform@noaa.gov"
                  git config user.name "epic-cicd-jenkins"
                  export machine_name_logs=$(echo $machine | awk '{ print tolower($1) }')
                  git remote -v | grep -w sshorigin > /dev/null 2>&1 && git remote remove sshorigin > /dev/null 2>&1
                  git remote add sshorigin $SSH_ORIGIN > /dev/null 2>&1
                  echo "Finalizing Hercules"
                  '''
                 } // always

              unstable{
                  echo "currentBuild.result $currentBuild.result"
                    sh '''
                  set +e
                  export machine=${NODE_NAME}
                  export PATH=$PATH:~/bin
                  export SSH_ORIGIN=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.repo.ssh_url')
                  export FORK_BRANCH=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.ref')
                  export ACCNR=epic
                  export GIT_OWNER=$(echo $GIT_URL | cut -d '/' -f4)
                  export GIT_REPO_NAME=$(echo $GIT_URL | cut -d '/' -f5 | cut -d '.' -f1)
                  
                  cd $WORKSPACE/tests/
                  export regional_dir=$(egrep opnReqTest_[1-9]* -m 1 logs/OpnReqTests_regional_control_hercules.log | cut -c 1-92)
                  export control_dir=$(egrep opnReqTest_[1-9]* -m 1 logs/OpnReqTests_control_p8_hercules.log | cut -c 1-92)

                    git add logs/OpnReqTests_control_p8_hercules.log logs/OpnReqTests_regional_control_hercules.log
                    git status
                    git commit -m "Hercules ORT FAILED.\nregional_dir=${regional_dir}\ncontrol_dir=${control_dir}\n on-behalf-of @ufs-community <ecc.platform@noaa.gov>"
                    git config pull.rebase false                    
                    git pull sshorigin $FORK_BRANCH
                    git push sshorigin HEAD:$FORK_BRANCH
                  echo "Hercules Failure"
                    '''
                  }

              success{
                  echo "currentBuild.result $currentBuild.result"
                    sh '''
                  set +e
                  export machine=${NODE_NAME}
                  export PATH=$PATH:~/bin
                  export SSH_ORIGIN=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.repo.ssh_url')
                  export FORK_BRANCH=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.ref')
                  export ACCNR=epic
                  export GIT_OWNER=$(echo $GIT_URL | cut -d '/' -f4)
                  export GIT_REPO_NAME=$(echo $GIT_URL | cut -d '/' -f5 | cut -d '.' -f1)
                  cd $WORKSPACE/tests/
                  export regional_dir=$(egrep opnReqTest_[1-9]* -m 1 logs/OpnReqTests_regional_control_hercules.log | cut -c 1-92)
                  export control_dir=$(egrep opnReqTest_[1-9]* -m 1 logs/OpnReqTests_control_p8_hercules.log | cut -c 1-92)
                    git add logs/OpnReqTests_control_p8_hercules.log logs/OpnReqTests_regional_control_hercules.log
                    git status
                   git commit -m "Hercules ORT Successful.\nregional_dir=${regional_dir}\ncontrol_dir=${control_dir}\n on-behalf-of @ufs-community <ecc.platform@noaa.gov>"
                    git config pull.rebase false
                    git pull sshorigin $FORK_BRANCH
                    git push sshorigin HEAD:$FORK_BRANCH
                  echo "Hercules Success"
                    '''
                   }

                } // end of post

            } // End of stage Finalize Hercules
          } // End of stages
        } // End of stage Hercules

        // Stage for Orion platform
        stage('Orion'){
          agent{ label 'orion' }
          options{
            timeout(time:   6,   unit:   'HOURS')
          }
          environment {
            ACCNR = 'epic'
            NODE_PATH = '/work/noaa/epic/role-epic/'
            GITHUB_TOKEN = credentials('GithubJenkinsNew')
          }
          when{ 
            beforeAgent true
              expression { env.CHOICE_NODE.contains("orion") }
          }
          stages{
            stage("regional_control"){
              steps{
                cleanWs()
                checkout scm
                script{
                def exitCode = sh(
                script: '''
                  set +e

                    log_error() {
                        echo "ERROR in $1 on line $2" > $WORKSPACE/tests/error.log
                    }

                  git submodule update --init --recursive
                  cd tests/fv3_conf
                  sed 's/#SBATCH --time=.*/#SBATCH --time=02:00:00/g' -i fv3_slurm.IN_orion
                  cd ..
                  export ACCNR=epic
                  pwd
                  ./opnReqTest -n regional_control -a ${ACCNR} -c bit,dcp,thr  || log_error OpenReqTest $LINENO
                  cd $WORKSPACE/tests/logs/
                  # change "cp" to "mv" to be tighter on logfiles existence (prevents using logfiles from a previous run)
                  mv OpnReqTests_regional_control_orion.log $WORKSPACE/..
                  cd ..
                  pwd
                     [ -s $WORKSPACE/tests/error.log ] && rm $WORKSPACE/tests/error.log && exit 1 || exit 0 
                  ''',
                  returnStatus: true
                ) // exitCode
                echo "Orion regional_control exit code: ${exitCode}"
                if (exitCode == 0) {
                  echo "Pipeline continuing normally."
                  region_result = 'SUCCESS'
                } else {
                // Suppress build failure: Mark STAGE as failed, but keep BUILD as success
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    error "Handling Orion regional_control failure in groovy, changing stage color to Unstable"
                }
                  region_result = 'FAILURE'
                }
                echo "region_result = ${region_result}"
                } //script

              } // End of steps
            } // End of stage regional_control
            
            stage("control_p8"){
              steps{
                cleanWs()
                checkout scm
                script{
                def exitCode = sh(
                script: '''
                  set +e

                    log_error() {
                        echo "ERROR in $1 on line $2" > $WORKSPACE/tests/error.log
                    }

                  git submodule update --init --recursive
                  cd tests/fv3_conf
                  sed 's/#SBATCH --time=.*/#SBATCH --time=02:00:00/g' -i fv3_slurm.IN_orion
                  cd ..
                  export ACCNR=epic
                  export GIT_OWNER=$(echo $GIT_URL | cut -d '/' -f4)
                  export GIT_REPO_NAME=$(echo $GIT_URL | cut -d '/' -f5 | cut -d '.' -f1)
                  echo "GIT_OWNER ${GIT_OWNER}"
                  echo "GIT_REPO_NAME ${GIT_REPO_NAME}"
                  pwd
                  ./opnReqTest -n control_p8 -a ${ACCNR} -c std,dbg,bit,mpi,rst,thr,dcp  || log_error OpenReqTest $LINENO
                  cd logs/
                  # change "cp" to "mv" to be tighter on logfiles existence (prevents using logfiles from a previous run)
                  mv OpnReqTests_control_p8_orion.log $WORKSPACE/..
                  cd ..
                  pwd
                  [ -s $WORKSPACE/tests/error.log ] && rm $WORKSPACE/tests/error.log && exit 1 || exit 0    
                  ''',
                  returnStatus: true
                ) // exitCode
                echo "Orion control_p8 exit code: ${exitCode}"
                if (exitCode == 0) {
                  echo "Pipeline continuing normally."
                  control_result = 'SUCCESS'
                } else {
                // Suppress build failure: Mark STAGE as failed, but keep BUILD as success
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    error "Handling Orion regional_control failure in groovy, changing stage color to Unstable"
                }
                  control_result = 'FAILURE'
                }
                echo "control_result = ${control_result}"
                } //script
              } // End of steps
            } // End of stage control_p8
            
            // Stage to finalize Orion operations
            stage("Finalize Orion"){ //
              steps{
                script{
                echo "test for fail"
                echo "region_result = ${region_result}"
                echo "control_result = ${control_result}"
                if ( region_result == 'FAILURE' || control_result == 'FAILURE') {
                   echo "Orion ORT Failed (Unstable)"
                   currentBuild.result='UNSTABLE'
                   stageResult='UNSTABLE'
                   orion_status='UNSTABLE'
                } else {
                   echo "Orion ORT Success"
                   currentBuild.result='SUCCESS'
                   stageResult='SUCCESS'
                } 
                } // script
                  sh '''
                  set +e
                  export machine=${NODE_NAME}
                  export PATH=$PATH:~/bin
                  export SSH_ORIGIN=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.repo.ssh_url')
                  export FORK_BRANCH=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.ref')
                  export ACCNR=epic
                  export GIT_OWNER=$(echo $GIT_URL | cut -d '/' -f4)
                  export GIT_REPO_NAME=$(echo $GIT_URL | cut -d '/' -f5 | cut -d '.' -f1)
                  echo "GIT_OWNER ${GIT_OWNER}"
                  echo "GIT_REPO_NAME ${GIT_REPO_NAME}"

                  pwd 
                  git remote -v
                  git fetch --no-recurse-submodules origin
                  git reset FETCH_HEAD --hard
                  cd $WORKSPACE/..

                  echo '3 cds'
                  pwd
                  ls -l

                  # change "cp" to "mv" to be tighter on logfiles existence (prevents using logfiles from a previous run)
                  mv OpnReqTests_control_p8_orion.log $WORKSPACE/tests/logs/
                  mv OpnReqTests_regional_control_orion.log $WORKSPACE/tests/logs/
                  '''
              } // End of steps 

              post{
                always{
                  echo "currentBuild.result $currentBuild.result"
                  sh '''
                  set +e
                  export machine=${NODE_NAME}
                  export PATH=$PATH:~/bin
                  export SSH_ORIGIN=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.repo.ssh_url')
                  export FORK_BRANCH=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.ref')
                  export ACCNR=epic
                  export GIT_OWNER=$(echo $GIT_URL | cut -d '/' -f4)
                  export GIT_REPO_NAME=$(echo $GIT_URL | cut -d '/' -f5 | cut -d '.' -f1)
                  git config user.email "ecc.platform@noaa.gov"
                  git config user.name "epic-cicd-jenkins"
                  export machine_name_logs=$(echo $machine | awk '{ print tolower($1) }')
                  git remote -v | grep -w sshorigin > /dev/null 2>&1 && git remote remove sshorigin > /dev/null 2>&1
                  git remote add sshorigin $SSH_ORIGIN > /dev/null 2>&1
                  echo "Finalizing Orion"
                  '''
                 } // always

              unstable{
                  echo "currentBuild.result $currentBuild.result"
                    sh '''
                  set +e
                  export machine=${NODE_NAME}
                  export PATH=$PATH:~/bin
                  export SSH_ORIGIN=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.repo.ssh_url')
                  export FORK_BRANCH=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.ref')
                  export ACCNR=epic
                  export GIT_OWNER=$(echo $GIT_URL | cut -d '/' -f4)
                  export GIT_REPO_NAME=$(echo $GIT_URL | cut -d '/' -f5 | cut -d '.' -f1)
                  
                  cd $WORKSPACE/tests/
                  export regional_dir=$(egrep opnReqTest_[1-9]* -m 1 logs/OpnReqTests_regional_control_orion.log | cut -c 1-95)
                  export control_dir=$(egrep opnReqTest_[1-9]* -m 1 logs/OpnReqTests_control_p8_orion.log | cut -c 1-95)

                    git add logs/OpnReqTests_control_p8_orion.log logs/OpnReqTests_regional_control_orion.log
                    git status
                    git commit -m "Orion ORT FAILED.\nregional_dir=${regional_dir}\ncontrol_dir=${control_dir}\n on-behalf-of @ufs-community <ecc.platform@noaa.gov>"
                    git config pull.rebase false
                    git pull sshorigin $FORK_BRANCH
                    git push sshorigin HEAD:$FORK_BRANCH
                  echo "Orion Failure"
                    '''
                  }
              success{
                  echo "currentBuild.result $currentBuild.result"
                    sh '''
                  set +e
                  export machine=${NODE_NAME}
                  export PATH=$PATH:~/bin
                  export SSH_ORIGIN=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.repo.ssh_url')
                  export FORK_BRANCH=$(curl --silent https://api.github.com/repos/arbetter/ufs-weather-model/pulls/$CHANGE_ID | jq -r '.head.ref')
                  export ACCNR=epic
                  export GIT_OWNER=$(echo $GIT_URL | cut -d '/' -f4)
                  export GIT_REPO_NAME=$(echo $GIT_URL | cut -d '/' -f5 | cut -d '.' -f1)
                  cd $WORKSPACE/tests/
                  export regional_dir=$(egrep opnReqTest_[1-9]* -m 1 logs/OpnReqTests_regional_control_orion.log | cut -c 1-95)
                  export control_dir=$(egrep opnReqTest_[1-9]* -m 1 logs/OpnReqTests_control_p8_orion.log | cut -c 1-95)
                    git add logs/OpnReqTests_control_p8_orion.log logs/OpnReqTests_regional_control_orion.log
                    git status
                   git commit -m "Orion ORT Successful.\nregional_dir=${regional_dir}\ncontrol_dir=${control_dir}\n on-behalf-of @ufs-community <ecc.platform@noaa.gov>"
                    git config pull.rebase false
                    git pull sshorigin $FORK_BRANCH
                    git push sshorigin HEAD:$FORK_BRANCH
                  echo "Orion Success"
                    '''
                   }

                } // end of post

            } // End of stage finalize orion
          } // End of stages
        } // End of stage Orion
      } // End of parallel
     } // End of stage Run ORTS in Parallel
           
     stage('Post'){
       agent { label 'built-in' }
          environment {
            ACCNR = 'epic'
            NODE_PATH = '/scratch3/NAGAPE/epic/role-epic/'
            GITHUB_TOKEN = credentials('GithubJenkinsNew')
          }
      steps{
          script{
            echo "test for fail"
            echo "ursa_status = ${ursa_status}"
            echo "hercules_status = ${hercules_status}"
            echo "orion_status = ${orion_status}"
            if ( ursa_status == 'UNSTABLE' || hercules_status == 'UNSTABLE' || orion_status == 'UNSTABLE') {
                echo "ORT Run Failed (Unstalbe)"
                currentBuild.result='UNSTABLE'
                stageResult='UNSTABLE'
                } 
            echo "Testing concluded for ${GIT_URL}"
            } // script
           }

      post {
        always{
               sh '''
                  set +e
                  export GIT_OWNER=$(echo $GIT_URL | cut -d '/' -f4)
                  export GIT_REPO_NAME=$(echo $GIT_URL | cut -d '/' -f5 | cut -d '.' -f1)
                  echo "Removing labels from $GIT_URL"
                  echo "https://api.github.com/repos/${GIT_OWNER}/${GIT_REPO_NAME}/issues/${CHANGE_ID}/labels/ursa-ORT"
                  curl --silent -X DELETE -H "Accept:   application/vnd.github.v3+json" -H "Authorization:   Bearer ${GITHUB_TOKEN}"  https://api.github.com/repos/${GIT_OWNER}/${GIT_REPO_NAME}/issues/${CHANGE_ID}/labels/ursa-ORT
                  echo "https://api.github.com/repos/${GIT_OWNER}/${GIT_REPO_NAME}/issues/${CHANGE_ID}/labels/hercules-ORT"
                  curl --silent -X DELETE -H "Accept:   application/vnd.github.v3+json" -H "Authorization:   Bearer ${GITHUB_TOKEN}"  https://api.github.com/repos/${GIT_OWNER}/${GIT_REPO_NAME}/issues/${CHANGE_ID}/labels/hercules-ORT
                  echo "https://api.github.com/repos/${GIT_OWNER}/${GIT_REPO_NAME}/issues/${CHANGE_ID}/labels/orion-ORT"
                  curl --silent -X DELETE -H "Accept:   application/vnd.github.v3+json" -H "Authorization:   Bearer ${GITHUB_TOKEN}"  https://api.github.com/repos/${GIT_OWNER}/${GIT_REPO_NAME}/issues/${CHANGE_ID}/labels/orion-ORT
                  sleep 60                  
                '''
        } // always

        success {
          slackSend (
            channel:   '#jenkins-notifications',   
            color:   'good',   
            message:   "*SUCCESS:   Build ${env.JOB_NAME} #${env.BUILD_NUMBER}* <${env.BUILD_URL}|Open Build>"
          )
        } // End of success
     
        unstable {
          slackSend (
            channel:   '#jenkins-notifications',   
            color:   'danger',   
            message:   "*FAILURE:   Build ${env.JOB_NAME} #${env.BUILD_NUMBER}* <${env.BUILD_URL}|Open Build>"
          ) // End of slacksend
        } // End of failure

      } // End of post
    } // End of stage Post

  } // End of stages
} // End of pipeline
